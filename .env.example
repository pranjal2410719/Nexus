# ============================================================
# Nexus — Open Source Multi-Tenant Commit Engine
#
# Copy this file to .env for local development, or configure
# the same keys under Netlify Dashboard → Site settings →
# Environment variables for production.
# ============================================================

# --- GitHub OAuth App (REQUIRED) ---
# 1. Go to https://github.com/settings/developers → "New OAuth App"
# 2. Homepage URL : https://YOUR-SITE.netlify.app
# 3. Callback URL : https://YOUR-SITE.netlify.app/api/auth/callback
# 4. Request the "repo" scope so users can authorize their own repositories.
#
# LOCAL DEV: create a SECOND OAuth App for http://localhost:3000 with
#   Homepage URL : http://localhost:3000
#   Callback URL : http://localhost:3000/api/auth/callback
# and use those credentials here.
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# --- Token encryption master key (REQUIRED) ---
# Used to encrypt each user's GitHub token at rest (AES-GCM).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BLOBS_MASTER_KEY=replace_with_a_random_64_char_hex_string

# --- Optional tunables ---
# Manual dispatch cap per user per day (default 50)
# MANUAL_DAILY_CAP=50

# --- Local development (optional) ---
# When running `npm run dev` outside Netlify, Nexus automatically uses a
# file-backed store (default .data/blobs) — no Blobs env vars needed.
# Override the directory with:
# LOCAL_BLOBS_DIR=.data/blobs
